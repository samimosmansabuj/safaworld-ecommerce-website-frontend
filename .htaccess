# Safa World — Production Clean URLs & Routing (.htaccess)
# Supports Apache, cPanel, and LiteSpeed web servers

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Redirect external requests for .html to clean URLs (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Allow existing physical files and directories (css, js, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Clean static pages: Map /about-us to about-us.html internally
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L,QSA]

# 4. Dynamic product slug routing: Map /:slug to product-details.html?slug=:slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ product-details.html?slug=$1 [L,QSA]
</IfModule>
