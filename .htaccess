# Safa World — Production Clean URLs & Routing (.htaccess)
# Optimized for Apache, cPanel, and LiteSpeed web servers

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ----------------------------------------------------------------------
# 1. NEVER REWRITE OR REDIRECT COMPONENTS OR PHYSICAL FILES/FOLDERS
#    Any file/folder that physically exists (CSS, JS, images, /components/*.html)
#    MUST be served directly without any redirect or rewrite!
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/components/ [NC,OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ----------------------------------------------------------------------
# 2. REDIRECT /index.html TO ROOT / (301 Permanent Redirect)
# ----------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ----------------------------------------------------------------------
# 3. REDIRECT ROOT-LEVEL .html PAGES TO CLEAN URLS (301 Permanent Redirect)
#    e.g. /product-list.html -> /product-list
#    Excludes /components/ and internal templates
# ----------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([a-zA-Z0-9_-]+)\.html [NC]
RewriteCond %1 !^(index|product-details)$ [NC]
RewriteRule ^([a-zA-Z0-9_-]+)\.html$ /$1 [R=301,L]

# ----------------------------------------------------------------------
# 4. REMOVE TRAILING SLASHES FROM NON-DIRECTORIES (SEO / Clean URL normalization)
#    e.g. /product-list/ -> /product-list
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/+$
RewriteRule ^ %1 [R=301,L]

# ----------------------------------------------------------------------
# 5. INTERNAL REWRITE: MAP CLEAN STATIC PAGES TO PHYSICAL .html FILES
#    e.g. /product-list -> product-list.html, /about-us -> about-us.html
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.html -f [OR]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.html [L,QSA]

# ----------------------------------------------------------------------
# 6. INTERNAL REWRITE: DYNAMIC PRODUCT SLUGS
#    e.g. /bike-throttle-design-drop-sholder-t-shirt -> product-details.html?slug=...
#    Strictly excludes static asset directories and API calls
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|css|js|images|components)/ [NC]
RewriteRule ^([a-zA-Z0-9_-]+)$ product-details.html?slug=$1 [L,QSA]

</IfModule>

# ----------------------------------------------------------------------
# MIME TYPES & HEADERS
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>
